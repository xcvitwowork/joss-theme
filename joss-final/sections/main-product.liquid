<style>
/* JOSS Product Page Styles */
.joss-product-page {
  padding: 32px 0 80px;
  max-width: 1200px;
  margin: 0 auto;
  padding-left: 24px;
  padding-right: 24px;
}
.joss-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  color: rgba(255,255,255,.5);
  margin-bottom: 36px;
  letter-spacing: 0.04em;
}
.joss-breadcrumb a {
  color: rgba(255,255,255,.5) !important;
  text-decoration: none;
  transition: color .2s;
}
.joss-breadcrumb a:hover { color: var(--joss-gold) !important; }
.joss-breadcrumb span { opacity: .5; }

.joss-product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: start;
}
@media(max-width:900px) {
  .joss-product-grid { grid-template-columns: 1fr; gap: 32px; }
  .joss-product-page { padding-top: 20px; }
}

/* Gallery */
.joss-gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
.joss-gallery-main {
  grid-column: 1 / -1;
  aspect-ratio: 4/3;
  overflow: hidden;
  cursor: zoom-in;
  position: relative;
}
.joss-gallery-main img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .6s cubic-bezier(.25,.46,.45,.94);
}
.joss-gallery-main:hover img { transform: scale(1.04); }
.joss-gallery-thumb {
  aspect-ratio: 1;
  overflow: hidden;
  cursor: pointer;
  border: 0.5px solid transparent;
  transition: border-color .2s;
}
.joss-gallery-thumb:hover,
.joss-gallery-thumb.active { border-color: var(--joss-gold); }
.joss-gallery-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .4s;
}
.joss-gallery-thumb:hover img { transform: scale(1.06); }

/* Info panel */
.joss-product-info { display: flex; flex-direction: column; gap: 0; }
.joss-vendor {
  font-size: 10px;
  letter-spacing: .32em;
  text-transform: uppercase;
  color: var(--joss-gold);
  font-weight: 600;
  margin-bottom: 10px;
}
.joss-product-title {
  font-size: clamp(26px, 3vw, 42px);
  font-weight: 700;
  letter-spacing: -.025em;
  line-height: 1.05;
  color: #fff;
  margin-bottom: 10px;
}
.joss-product-subtitle {
  font-size: 12px;
  color: rgba(255,255,255,.55);
  letter-spacing: .06em;
  margin-bottom: 18px;
  font-weight: 300;
}
.joss-stars {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 20px;
  font-size: 14px;
  color: var(--joss-gold);
}
.joss-stars-count { font-size: 11px; color: rgba(255,255,255,.5); }
.joss-price-row {
  display: flex;
  align-items: baseline;
  gap: 12px;
  padding: 20px 0;
  border-top: .5px solid rgba(255,255,255,.07);
  border-bottom: .5px solid rgba(255,255,255,.07);
  margin-bottom: 24px;
}
.joss-price {
  font-size: 32px;
  font-weight: 700;
  letter-spacing: -.03em;
  color: #fff;
}
.joss-price-compare {
  font-size: 16px;
  color: rgba(255,255,255,.45);
  text-decoration: line-through;
  font-weight: 400;
}
.joss-price-save {
  font-size: 9px;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--joss-gold);
  font-weight: 700;
  border: .5px solid rgba(208,155,74,.35);
  padding: 4px 9px;
}
.joss-variant-label {
  font-size: 10px;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: rgba(255,255,255,.55);
  font-weight: 500;
  margin-bottom: 10px;
}
.joss-variant-label strong { color: #fff; font-weight: 600; }
.joss-variants {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 22px;
}
.joss-variant-btn {
  background: transparent;
  border: .5px solid rgba(255,255,255,.2);
  color: rgba(255,255,255,.75);
  padding: 9px 16px;
  font: 500 11px/1 'Montserrat', sans-serif;
  letter-spacing: .1em;
  cursor: pointer;
  transition: all .2s;
  text-transform: uppercase;
}
.joss-variant-btn:hover,
.joss-variant-btn.selected {
  border-color: var(--joss-gold);
  color: var(--joss-gold);
  background: rgba(208,155,74,.06);
}
.joss-qty-row {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 16px;
}
.joss-qty {
  display: flex;
  align-items: center;
  border: .5px solid rgba(255,255,255,.2);
}
.joss-qty-btn {
  width: 40px;
  height: 40px;
  background: transparent;
  border: none;
  color: var(--joss-gold);
  font-size: 20px;
  cursor: pointer;
  font-family: 'Montserrat', sans-serif;
  transition: color .2s;
  display: flex;
  align-items: center;
  justify-content: center;
}
.joss-qty-btn:hover { color: var(--joss-gold-lt); }
.joss-qty-val {
  width: 44px;
  text-align: center;
  font-size: 14px;
  font-weight: 600;
  color: #fff;
  border-left: .5px solid rgba(255,255,255,.2);
  border-right: .5px solid rgba(255,255,255,.2);
  line-height: 40px;
  height: 40px;
  display: block;
}
.joss-add-btn {
  width: 100%;
  background: var(--joss-gold);
  color: #000;
  padding: 14px;
  font: 700 11px/1 'Montserrat', sans-serif;
  letter-spacing: .24em;
  text-transform: uppercase;
  border: none;
  cursor: pointer;
  transition: background .2s, transform .18s;
  margin-bottom: 10px;
}
.joss-add-btn:hover { background: var(--joss-gold-lt); transform: translateY(-1px); }
.joss-add-btn:disabled { opacity: .5; cursor: not-allowed; transform: none; }
.joss-secondary-btn {
  width: 100%;
  background: transparent;
  color: #fff;
  padding: 13px;
  font: 600 11px/1 'Montserrat', sans-serif;
  letter-spacing: .2em;
  text-transform: uppercase;
  border: .5px solid rgba(255,255,255,.28);
  cursor: pointer;
  transition: all .2s;
  margin-bottom: 22px;
  text-decoration: none;
  display: block;
  text-align: center;
}
.joss-secondary-btn:hover { border-color: var(--joss-gold); color: var(--joss-gold); }
.joss-upsell-link {
  font: 500 10.5px/1 'Montserrat', sans-serif;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: rgba(255,255,255,.5);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  margin-bottom: 24px;
  transition: color .2s;
}
.joss-upsell-link:hover { color: var(--joss-gold); }

/* Accordion */
.joss-accordion { border-top: .5px solid rgba(255,255,255,.07); margin-top: 8px; }
.joss-acc-item { border-bottom: .5px solid rgba(255,255,255,.07); }
.joss-acc-btn {
  width: 100%;
  background: transparent;
  border: none;
  text-align: left;
  padding: 16px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  font: 600 13px/1 'Montserrat', sans-serif;
  color: #fff;
  letter-spacing: .04em;
  transition: color .2s;
}
.joss-acc-btn:hover { color: var(--joss-gold); }
.joss-acc-icon {
  font-size: 18px;
  color: var(--joss-gold);
  transition: transform .25s;
  flex-shrink: 0;
  line-height: 1;
}
.joss-acc-btn.open .joss-acc-icon { transform: rotate(45deg); }
.joss-acc-body {
  max-height: 0;
  overflow: hidden;
  transition: max-height .35s cubic-bezier(.25,.46,.45,.94);
}
.joss-acc-body.open { max-height: 600px; }
.joss-acc-content {
  padding: 0 0 16px;
  font-size: 13px;
  color: rgba(255,255,255,.65);
  line-height: 1.9;
  font-weight: 300;
}
.joss-acc-content ul { padding-left: 18px; }
.joss-acc-content li { margin-bottom: 6px; }
.joss-acc-content p { margin-bottom: 8px; }
</style>

<product-info
  id="MainProduct-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
>

<div class="joss-product-page">
  <!-- Breadcrumb -->
  <nav class="joss-breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">→</span>
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a>
      <span aria-hidden="true">→</span>
    {%- else -%}
      <a href="{{ routes.all_products_collection_url }}">Products</a>
      <span aria-hidden="true">→</span>
    {%- endif -%}
    <span>{{ product.title }}</span>
  </nav>

  <div class="joss-product-grid">

    <!-- GALLERY -->
    <div class="joss-gallery">
      <div class="joss-gallery-main">
        {%- if product.featured_media -%}
          <img src="{{ product.featured_media | image_url: width: 1000 }}"
               alt="{{ product.featured_media.alt | default: product.title | escape }}"
               id="joss-main-img"
               loading="eager"
               fetchpriority="high">
        {%- endif -%}
      </div>
      {%- for media in product.media limit: 6 offset: 1 -%}
        <div class="joss-gallery-thumb" onclick="
          document.getElementById('joss-main-img').src = '{{ media | image_url: width: 1000 }}';
          document.querySelectorAll('.joss-gallery-thumb').forEach(t=>t.classList.remove('active'));
          this.classList.add('active');
        ">
          <img src="{{ media | image_url: width: 400 }}"
               alt="{{ media.alt | default: product.title | escape }}"
               loading="lazy">
        </div>
      {%- endfor -%}
    </div>

    <!-- PRODUCT INFO -->
    <div class="joss-product-info">
      <!-- Vendor -->
      {%- if product.vendor != blank -%}
        <div class="joss-vendor">{{ product.vendor }}</div>
      {%- else -%}
        <div class="joss-vendor">JOSS Cosmetics</div>
      {%- endif -%}

      <!-- Title -->
      <h1 class="joss-product-title">{{ product.title }}</h1>

      <!-- Subtitle from metafield -->
      {%- if product.metafields.custom.tagline != blank -%}
        <div class="joss-product-subtitle">{{ product.metafields.custom.tagline }}</div>
      {%- endif -%}

      <!-- Stars / Rating -->
      {%- if product.metafields.reviews.rating != blank -%}
        <div class="joss-stars">
          <span>★★★★★</span>
          <span class="joss-stars-count">{{ product.metafields.reviews.rating.value }} · {{ product.metafields.reviews.rating_count }} reviews</span>
        </div>
      {%- else -%}
        {%- comment -%} Loox app renders stars here {%- endcomment -%}
        <div id="loox-{{ product.id }}" style="margin-bottom:18px"></div>
      {%- endif -%}

      <!-- Price -->
      {%- assign current_variant = product.selected_or_first_available_variant -%}
      <div class="joss-price-row">
        <span class="joss-price" id="joss-price">{{ current_variant.price | money }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="joss-price-compare">{{ current_variant.compare_at_price | money }}</span>
          {%- assign savings_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
          <span class="joss-price-save">–{{ savings_pct }}%</span>
        {%- endif -%}
      </div>

      <!-- Variants -->
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div class="joss-variant-label">
            {{ option.name }}: <strong id="selected-{{ option.name | handleize }}">{{ current_variant.options[forloop.index0] }}</strong>
          </div>
          <div class="joss-variants">
            {%- for value in option.values -%}
              <button type="button"
                      class="joss-variant-btn{% if value == current_variant.options[forloop.index0] %} selected{% endif %}"
                      data-option-index="{{ forloop.index0 }}"
                      data-value="{{ value }}"
                      onclick="jossSelectVariant(this, '{{ option.name | handleize }}', '{{ value }}')">
                {{ value }}
              </button>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      {%- endunless -%}

      <!-- Form -->
      {%- form 'product', product, id: 'joss-product-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" id="joss-variant-id">

        <!-- Qty + Add -->
        <div class="joss-qty-row">
          <div class="joss-qty">
            <button type="button" class="joss-qty-btn" onclick="jossQty(-1)" aria-label="Decrease">−</button>
            <span class="joss-qty-val" id="joss-qty">1</span>
            <button type="button" class="joss-qty-btn" onclick="jossQty(1)" aria-label="Increase">+</button>
          </div>
        </div>

        <button type="submit"
                id="joss-add-btn"
                class="joss-add-btn"
                {% unless current_variant.available %}disabled{% endunless %}>
          {%- if current_variant.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
        </button>

        <!-- Dynamic checkout (Buy it now) -->
        {%- if section.settings.show_dynamic_checkout -%}
          {{ form | payment_button }}
        {%- endif -%}
      {%- endform -%}

      <!-- Upsell link -->
      {%- if settings.show_bundle_upsell != false -%}
        <a href="/collections/all" class="joss-upsell-link">View Big Set –10% →</a>
      {%- endif -%}

      <!-- Accordion: description, how to use, ingredients, shipping -->
      <div class="joss-accordion">
        {%- if product.description != blank -%}
          <div class="joss-acc-item">
            <button class="joss-acc-btn" type="button" onclick="jossAccordion(this)">
              Description <span class="joss-acc-icon">+</span>
            </button>
            <div class="joss-acc-body">
              <div class="joss-acc-content">{{ product.description }}</div>
            </div>
          </div>
        {%- endif -%}

        {%- if product.metafields.custom.how_to_use != blank -%}
          <div class="joss-acc-item">
            <button class="joss-acc-btn" type="button" onclick="jossAccordion(this)">
              How to Use <span class="joss-acc-icon">+</span>
            </button>
            <div class="joss-acc-body">
              <div class="joss-acc-content">{{ product.metafields.custom.how_to_use }}</div>
            </div>
          </div>
        {%- endif -%}

        {%- if product.metafields.custom.ingredients != blank -%}
          <div class="joss-acc-item">
            <button class="joss-acc-btn" type="button" onclick="jossAccordion(this)">
              Ingredients <span class="joss-acc-icon">+</span>
            </button>
            <div class="joss-acc-body">
              <div class="joss-acc-content">{{ product.metafields.custom.ingredients }}</div>
            </div>
          </div>
        {%- endif -%}

        <div class="joss-acc-item">
          <button class="joss-acc-btn" type="button" onclick="jossAccordion(this)">
            Shipping & Returns <span class="joss-acc-icon">+</span>
          </button>
          <div class="joss-acc-body">
            <div class="joss-acc-content">
              Free shipping on orders over $50. Standard delivery 3–7 business days. Returns accepted within 30 days for unopened items.
            </div>
          </div>
        </div>
      </div>

      <!-- Blocks (apps, etc.) -->
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div><!-- /joss-product-info -->
  </div><!-- /joss-product-grid -->
</div><!-- /joss-product-page -->

</product-info>

<!-- Related products -->
{%- if product.collections.first -%}
  {%- assign rel_col = product.collections.first -%}
  {%- if rel_col.products.size > 1 -%}
    <div style="padding:0 24px 80px;max-width:1200px;margin:0 auto;border-top:.5px solid rgba(255,255,255,.07);padding-top:60px">
      <div style="font-size:10px;letter-spacing:.32em;text-transform:uppercase;color:var(--joss-gold);font-weight:600;margin-bottom:10px;display:flex;align-items:center;gap:8px">
        <span style="width:16px;height:.5px;background:var(--joss-gold);display:inline-block"></span>Complete your ritual
      </div>
      <h2 style="font-size:clamp(22px,3vw,34px);font-weight:700;letter-spacing:-.02em;color:#fff;margin-bottom:36px">You may also like</h2>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:24px">
        {%- for p in rel_col.products limit: 4 -%}
          {%- unless p.handle == product.handle -%}
            <a href="{{ p.url }}" style="text-decoration:none;color:inherit;display:block">
              <div style="aspect-ratio:3/4;overflow:hidden;background:rgba(0,0,0,.25);border:.5px solid rgba(208,155,74,.1);margin-bottom:12px;position:relative">
                {%- if p.featured_image -%}
                  <img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s">
                {%- endif -%}
              </div>
              <div style="font-size:13px;font-weight:600;color:#fff;margin-bottom:4px">{{ p.title }}</div>
              <div style="font-size:14px;font-weight:700;color:#fff">{{ p.price_min | money }}</div>
            </a>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

<script>
// Qty
function jossQty(delta){
  const el = document.getElementById('joss-qty');
  let n = parseInt(el.textContent)||1;
  n = Math.max(1, n + delta);
  el.textContent = n;
}

// Accordion
function jossAccordion(btn){
  const body = btn.nextElementSibling;
  const isOpen = btn.classList.contains('open');
  document.querySelectorAll('.joss-acc-btn.open').forEach(b=>{
    b.classList.remove('open');
    b.nextElementSibling.classList.remove('open');
  });
  if(!isOpen){ btn.classList.add('open'); body.classList.add('open'); }
}

// Variant selection
function jossSelectVariant(btn, optionHandle, value){
  btn.closest('.joss-variants').querySelectorAll('.joss-variant-btn').forEach(b=>b.classList.remove('selected'));
  btn.classList.add('selected');
  const labelEl = document.getElementById('selected-' + optionHandle);
  if(labelEl) labelEl.textContent = value;
  // Try to match variant
  const form = document.getElementById('joss-product-form');
  if(!form) return;
  const allSelected = Array.from(document.querySelectorAll('.joss-variants')).map(row => {
    const sel = row.querySelector('.joss-variant-btn.selected');
    return sel ? sel.dataset.value : null;
  }).filter(Boolean);
  // Find matching variant ID from Shopify variants JSON
  const variantsJSON = document.getElementById('joss-variants-json');
  if(variantsJSON){
    const variants = JSON.parse(variantsJSON.textContent);
    const match = variants.find(v => {
      return allSelected.every((val, i) => v.options[i] === val);
    });
    if(match){
      document.getElementById('joss-variant-id').value = match.id;
      const priceEl = document.getElementById('joss-price');
      if(priceEl) priceEl.textContent = (match.price / 100).toLocaleString('en-US', {style:'currency', currency:'USD'});
      const addBtn = document.getElementById('joss-add-btn');
      if(addBtn){
        addBtn.disabled = !match.available;
        addBtn.textContent = match.available ? 'Add to Cart' : 'Sold Out';
      }
    }
  }
}
</script>

<script id="joss-variants-json" type="application/json">
  [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id }},
        "title": {{ variant.title | json }},
        "price": {{ variant.price }},
        "available": {{ variant.available }},
        "options": [{{ variant.options | map: 'json' | join: ',' }}]
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "blocks": [
    { "type": "@app" },
    {
      "type": "complementary_products",
      "name": "t:sections.main-product.blocks.complementary_products.name",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "t:sections.main-product.blocks.complementary_products.settings.paragraph__1.content" },
        { "type": "text", "id": "heading", "default": "t:sections.main-product.blocks.complementary_products.settings.heading.default", "label": "t:sections.main-product.blocks.complementary_products.settings.heading.label" },
        { "type": "range", "id": "product_list_limit", "min": 1, "max": 10, "step": 1, "default": 10, "label": "t:sections.main-product.blocks.complementary_products.settings.product_list_limit.label" },
        { "type": "range", "id": "products_per_page", "min": 1, "max": 4, "step": 1, "default": 2, "label": "t:sections.main-product.blocks.complementary_products.settings.products_per_page.label" },
        { "type": "select", "id": "pagination_style", "default": "dots", "label": "t:sections.main-product.blocks.complementary_products.settings.pagination_style.label", "options": [{"value":"dots","label":"t:sections.main-product.blocks.complementary_products.settings.pagination_style.options.dots"},{"value":"counter","label":"t:sections.main-product.blocks.complementary_products.settings.pagination_style.options.counter"},{"value":"numbers","label":"t:sections.main-product.blocks.complementary_products.settings.pagination_style.options.numbers"}] }
      ]
