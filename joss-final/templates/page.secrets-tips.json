ections.rich-text.presets.name","settings":{"desktop_content_position":"right","content_alignment":"left","color_scheme":"scheme-3","full_width":true,"padding_top":0,"padding_bottom":52}},"ss_video_with_text_5_XnMgKC":{"type":"ss-video-with-text-5","blocks":{"slide_GPF6Dd":{"type":"slide","settings":{"heading":"<p>Liquid Bronzer<\/p>","text":"<p>1. Shake well before use to ensure an even texture.<br\/>2. Choose your preferred application method:<\/p><p>• by hand with protective rubber gloves<\/p><p>• with a special soft tanning mitt for bronzers\/self-tanners<\/p><p>3. Pour the bronzer into your palm or directly onto the body and spread it quickly and evenly. Pay extra attention to areas where the product may accumulate.<\/p><p>4. Adjust the color intensity with layers — apply one or two. For the most intense effect, we recommend applying two layers with rubber gloves.<\/p>","button":"Buy it now","button_url":"shopify:\/\/products\/liquid-bronzer-light-tanning-effect","media_type":"video","video":"shopify:\/\/files\/videos\/IMG_8363.MP4","video_url":"https:\/\/www.youtube.com\/watch?v=_9VUPq3SxOc"}}},"block_order":["slide_GPF6Dd"],"name":"Bronze","settings":{"slide_gap":48,"slide_gap_mobile":32,"media_position":"left","media_position_mobile":"top","media_radius":12,"media_border_thickness":0,"media_ratio":"portrait","media_ratio_mobile":"portrait","content_vertical_align":"center","content_horizontal_align":"start","content_horizontal_align_mobile":"start","heading_custom":false,"heading_font":"josefin_sans_n4","heading_size":44,"heading_size_mobile":24,"heading_height":110,"heading_mt_mobile":24,"text_custom":false,"text_font":"josefin_sans_n4","text_size":18,"text_size_mobile":18,"text_height":170,"text_mt":32,"button_custom":false,"button_font":"josefin_sans_n4","button_size":16,"button_size_mobile":16,"button_height":100,"button_mt":32,"button_padding_vertical":16,"button_padding_vertical_mobile":16,"button_padding_horizontal":38,"button_padding_horizontal_mobil