{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"padding_top":36,"padding_bottom":36}},"rich_text_rr4TnQ":{"type":"rich-text","blocks":{"heading_Tr6GQj":{"type":"heading","settings":{"heading":"Application Tips from the JOSS Cosmetics Team","heading_size":"h1"}}},"block_order":["heading_Tr6GQj"],"name":"t:sections.rich-text.presets.name","settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"scheme-3","full_width":true,"padding_top":40,"padding_bottom":52}},"ss_video_with_text_5_FdFxKR":{"type":"ss-video-with-text-5","blocks":{"slide_7JgapP":{"type":"slide","settings":{"heading":"<p>Body Tanning Cream<\/p>","text":"<p>1. Skin preparation. Our formula works beautifully even without special rituals.<\/p><p>(Optionally, 10–12 hours before application, you may do a gentle scrub and moisturize the skin — especially on dry areas.)<\/p><p>2. Shake the bottle to ensure the formula is perfectly blended.<\/p><p>3. Apply the cream in a sufficient amount to clean, dry skin. Place small dots over the body and spread it right away across larger areas for a smooth, even result.<\/p><p>4. Perfect result<br\/>One layer is enough to create a beautiful, rich effect. Multiple layers are not recommended.<\/p>","button":"Buy it now","button_url":"shopify:\/\/products\/body-tanning-cream1","media_type":"video","video":"shopify:\/\/files\/videos\/IMG_8364.MP4","video_url":"https:\/\/www.youtube.com\/watch?v=_9VUPq3SxOc"}}},"block_order":["slide_7JgapP"],"name":"Body tan","settings":{"slide_gap":48,"slide_gap_mobile":32,"media_position":"left","media_position_mobile":"top","media_radius":12,"media_border_thickness":0,"media_ratio":"portrait","media_ratio_mobile":"portrait","content_vertical_align":"center","content_horizontal_align":"start","content_horizontal_align_mobile":"start","heading_custom":false,"heading_font":"josefin_sans_n4","heading_size":44,"heading_size_mobile":24,"heading_height":110,"heading_mt_mobile":24,"text_custo