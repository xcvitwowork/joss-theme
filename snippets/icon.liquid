<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
{%- when 'tiktok' -%}
<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.5 3c.3 2 1.6 3.5 3.5 3.8V9c-1.4 0-2.6-.4-3.6-1.1v6.6c0 3-2.3 5.5-5.3 5.5S5.8 17.5 5.8 14.5 8.1 9 11.1 9c.3 0 .6 0 .9.1v2.4c-.3-.1-.6-.2-.9-.2-1.5 0-2.7 1.2-2.7 2.8s1.2 2.8 2.7 2.8 2.7-1.2 2.7-2.8V3h2.7z"/></svg>
{%- when 'facebook' -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 8h-2a2 2 0 00-2 2v11M8 13h6"/><path d="M11 21V10a4 4 0 014-4h1"/></svg>
{%- when 'sparkle' -%}
