[
  {
    "name": "theme_info",
    "theme_name": "JOSS Cosmetics",
    "theme_version": "1.1.0",
    "theme_author": "JOSS Cosmetics",
    "theme_documentation_url": "https://josscosmetics.com",
    "theme_support_url": "https://josscosmetics.com"
  },
  {
    "name": "Color schemes",
    "settings": [
      { "type": "color_scheme_group", "id": "color_schemes", "label": "Color schemes",
        "definition": [
          { "type": "color", "id": "background", "label": "Background", "default": "#0a0503" },
          { "type": "color", "id": "text", "label": "Text", "default": "#ffffff" },
          { "type": "color", "id": "button", "label": "Button", "default": "#D09B4A" },
          { "type": "color", "id": "button_label", "label": "Button label", "default": "#000000" }
        ],
        "role": {
          "background": { "solid": "background" },
          "text": "text",
          "primary_button": "button",
          "on_primary_button": "button_label"
        }
      }
    ]
  },
  {
    "name": "Logo & Favicon",
    "settings": [
      { "type": "image_picker", "id": "logo",       "label": "Logo (PNG transparent background)" },
      { "type": "range",        "id": "logo_width", "label": "Logo width (px)", "min": 60, "max": 220, "step": 4, "default": 120 },
      { "type": "image_picker", "id": "favicon",    "label": "Favicon (32x32 PNG)" }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_gold",       "label": "Gold (primary)",  "default": "#D09B4A" },
      { "type": "color", "id": "color_gold_light", "label": "Gold (hover)",    "default": "#E8B870" },
      { "type": "color", "id": "color_bg",         "label": "Background base", "default": "#000000" }
    ]
  },
  {
    "name": "Announcement Bar",
    "settings": [
      { "type": "checkbox", "id": "show_announcement",  "label": "Show announcement bar", "default": true },
      { "type": "text",     "id": "announcement_text",  "label": "Text", "default": "✦ Free shipping on orders over $50 · Big Set –10% off ✦" },
      { "type": "url",      "id": "announcement_url",   "label": "Link (optional)" }
    ]
  },
  {
    "name": "Search",
    "settings": [
      { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search products…" }
    ]
  },
  {
    "name": "Product Pages",
    "settings": [
      { "type": "checkbox", "id": "show_bundle_upsell", "label": "Show Big Set upsell link", "default": true },
      { "type": "url",      "id": "bundle_url",         "label": "Big Set URL" },
      { "type": "textarea", "id": "shipping_text",      "label": "Shipping & Returns text",
        "default": "Free shipping on orders over $50. Standard delivery 3–7 business days. Returns within 30 days." }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "url", "id": "social_tiktok",    "label": "TikTok URL" },
      { "type": "url", "id": "social_facebook",  "label": "Facebook URL" }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      { "type": "checkbox",  "id": "show_currency_bar",    "label": "Show currency bar",  "default": true },
      { "type": "text",      "id": "footer_tagline",       "label": "Footer tagline",     "default": "Trusted by Champions" },
      { "type": "textarea",  "id": "footer_description",   "label": "Footer description", "default": "Professional cosmetics for dance and stage. Made in Ukraine." }
    ]
  }
]
