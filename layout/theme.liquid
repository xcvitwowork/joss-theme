<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{% if page_description %}{{ page_description | escape }}{% else %}{{ shop.description | default: shop.name | escape }}{% endif %}">
  <title>{% if page_title %}{{ page_title }} — {% endif %}{{ shop.name }}</title>
  <link rel="canonical" href="{{ canonical_url }}">

  {%- comment -%} Open Graph / social sharing {%- endcomment -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
  <meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
  <meta property="og:description" content="{% if page_description %}{{ page_description | escape }}{% else %}{{ shop.description | default: shop.name | escape }}{% endif %}">
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if request.page_type == 'product' and product.featured_media -%}
    <meta property="og:image" content="https:{{ product.featured_media | image_url: width: 1200 }}">
  {%- elsif settings.logo -%}
    <meta property="og:image" content="https:{{ settings.logo | image_url: width: 1200 }}">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

  {%- if settings.favicon -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {%- endif -%}

  {{ 'joss-theme.css' | asset_url | stylesheet_tag }}

  <script>document.documentElement.className = document.documentElement.className.replace('no-js','js');</script>
</head>

<body class="template-{{ template.name }}{% if template.suffix != blank %} template-{{ template.name }}-{{ template.suffix }}{% endif %}{% if settings.show_announcement %} has-announcement{% endif %}">

  <a class="skip-to-content" href="#MainContent">Skip to content</a>

  {%- sections 'header-group' -%}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- sections 'footer-group' -%}

  <div id="joss-cart-drawer" class="cart-drawer" aria-hidden="true">
    {%- render 'cart-drawer' -%}
  </div>
  <div id="joss-overlay" class="site-overlay" onclick="joss.closeAll()"></div>

  <div id="toast" class="toast" aria-live="polite"></div>

  {{ 'joss-theme.js' | asset_url | script_tag }}
</body>
</html>
