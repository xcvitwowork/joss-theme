<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ page_description | escape }}">
  <title>{% if page_title %}{{ page_title }} — {% endif %}{{ shop.name }}</title>

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet">

  {%- if settings.favicon -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {%- endif -%}

  {{ 'joss-theme.css' | asset_url | stylesheet_tag }}

  <script>document.documentElement.className = document.documentElement.className.replace('no-js','js');</script>
</head>

<body class="template-{{ template.name }}{% if template.suffix != blank %} template-{{ template.name }}-{{ template.suffix }}{% endif %}{% if settings.show_announcement %} has-announcement{% endif %}">

  <a class="skip-to-content" href="#MainContent">Skip to content</a>

  {%- sections 'header-group' -%}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- sections 'footer-group' -%}

  <div id="joss-cart-drawer" class="cart-drawer" aria-hidden="true">
    {%- render 'cart-drawer' -%}
  </div>
  <div id="joss-overlay" class="site-overlay" onclick="joss.closeAll()"></div>

  <div id="toast" class="toast" aria-live="polite"></div>

  {{ 'joss-theme.js' | asset_url | script_tag }}
</body>
</html>
