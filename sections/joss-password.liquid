<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:40px 20px">
  <div>
    <div style="font-size:10px;letter-spacing:.32em;text-transform:uppercase;color:#D09B4A;font-weight:600;margin-bottom:16px">Coming Soon</div>
    <h1 style="font-size:clamp(36px,6vw,72px);font-weight:700;letter-spacing:-.025em;margin-bottom:16px">{{ shop.name }}</h1>
    <p style="font-size:14px;color:rgba(255,255,255,.6);margin-bottom:40px">We are getting ready.</p>
    {%- form 'storefront_password' -%}
      <div style="display:flex;max-width:400px;margin:0 auto">
        <input type="password" name="password" placeholder="Password" style="flex:1;background:rgba(255,255,255,.05);border:.5px solid rgba(255,255,255,.2);border-right:none;color:#fff;padding:12px 18px;font-family:inherit;outline:none">
        <button type="submit" style="background:#D09B4A;color:#000;padding:12px 24px;border:none;font:700 11px/1 inherit;letter-spacing:.2em;text-transform:uppercase;cursor:pointer">Enter</button>
      </div>
    {%- endform -%}
  </div>
</div>
{% schema %}{"name":"Password","tag":"div","presets":[{"name":"Password"}]}{% endschema %}
