<div class="page-width" style="max-width:760px;padding:60px 24px 80px">
  <nav class="breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span class="breadcrumb__sep">-></span>
    <a href="{{ blog.url }}">{{ blog.title }}</a>
    <span class="breadcrumb__sep">-></span>
    <span>{{ article.title }}</span>
  </nav>
  <h1 style="font-size:clamp(28px,4vw,48px);font-weight:700;margin:24px 0 16px">{{ article.title }}</h1>
  <p style="font-size:12px;color:rgba(255,255,255,.4);margin-bottom:36px">{{ article.published_at | date: "%B %d, %Y" }}</p>
  {%- if article.image -%}
    <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | escape }}" style="width:100%;margin-bottom:32px">
  {%- endif -%}
  <div class="rte" style="font-size:14px;line-height:1.9;color:rgba(255,255,255,.8)">{{ article.content }}</div>
</div>
{% schema %}{"name":"Article","tag":"div","presets":[{"name":"Article"}]}{% endschema %}
