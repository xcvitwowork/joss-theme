<div class="page-width" style="padding:60px 0 80px">
  <h1 style="font-size:clamp(28px,3vw,44px);font-weight:700;margin-bottom:32px">My Account</h1>
  <a href="{{ routes.account_logout_url }}" class="btn btn--secondary" style="margin-bottom:32px;display:inline-flex">Log out</a>
  {%- if customer.orders.size == 0 -%}
    <p style="color:rgba(255,255,255,.5)">No orders yet. <a href="{{ routes.all_products_collection_url }}" style="color:#D09B4A">Start shopping</a></p>
  {%- else -%}
    {%- for order in customer.orders -%}
      <div style="padding:16px 0;border-bottom:.5px solid rgba(255,255,255,.07);display:flex;justify-content:space-between;align-items:center">
        <div>
          <a href="{{ order.customer_url }}" style="font-weight:600;color:#D09B4A">{{ order.name }}</a>
          <p style="font-size:12px;color:rgba(255,255,255,.5);margin-top:4px">{{ order.created_at | date: "%B %d, %Y" }}</p>
        </div>
        <span style="font-weight:700">{{ order.total_price | money }}</span>
      </div>
    {%- endfor -%}
  {%- endif -%}
</div>
{% schema %}{"name":"Account","tag":"div","presets":[{"name":"Account"}]}{% endschema %}
