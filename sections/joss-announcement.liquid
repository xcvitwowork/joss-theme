{%- if section.settings.text != blank -%}
  <div class="announcement-bar">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      {{ section.settings.text }}
    {%- endif -%}
    {%- if section.settings.show_close -%}
      <button class="announcement-bar__close" aria-label="Close">✕</button>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    { "type": "text",     "id": "text",       "label": "Text",         "default": "✦ Free shipping on orders over $50 · Big Set –10% off ✦" },
    { "type": "url",      "id": "link",       "label": "Link (optional)" },
    { "type": "checkbox", "id": "show_close", "label": "Show close button", "default": false }
  ]
}
{% endschema %}
