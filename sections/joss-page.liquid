<div class="page-width main-page">
  {%- if section.settings.show_eyebrow -%}
    <div class="main-page__eyebrow">{{ section.settings.eyebrow | default: 'JOSS Cosmetics' }}</div>
  {%- endif -%}
  <h1 class="main-page__title">{{ page.title }}</h1>
  <div class="rte">{{ page.content }}</div>
</div>
{% schema %}
{
  "name": "Page",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow label", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "JOSS Cosmetics" }
  ],
  "presets": [{ "name": "Page" }]
}
{% endschema %}
